<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath />
	</parent>
	<groupId>com.fourati</groupId>
	<artifactId>backend</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>ProjectAdmin</name>
	<description>Yassine Fourati — Admin API: a modular monolith (Spring Modulith) built as a platform library plus one application module (ADR 0004)</description>

	<properties>
		<!-- Bytecode level. The image builds and runs on Java 25 (Dockerfile); the source level follows once
		     every developer machine has JDK 25 (one-line change here, the IDE picks it up). -->
		<java.version>21</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<lombok.version>1.18.46</lombok.version>
		<springdoc.version>2.8.0</springdoc.version>
		<!-- swagger-core line used by springdoc ${springdoc.version}; platform only needs its annotations -->
		<swagger.version>2.2.27</swagger.version>
		<logstash.version>8.0</logstash.version>
		<rest-assured.version>6.0.1</rest-assured.version>
		<!-- Testcontainers is managed by the Spring Boot parent (2.x); do not pin 1.x here,
		     its Docker client is refused by Docker Engine 29+. -->
		<archunit.version>1.3.0</archunit.version>
		<shedlock.version>7.10.1</shedlock.version>
		<spring-modulith.version>2.0.8</spring-modulith.version>
		<commons-csv.version>1.12.0</commons-csv.version>
		<openpdf.version>2.0.3</openpdf.version>
	</properties>

	<modules>
		<module>platform</module>
		<module>app</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Internal modules — declared once here so children just reference version-less -->
			<dependency>
				<groupId>com.fourati</groupId>
				<artifactId>platform</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fourati</groupId>
				<artifactId>app</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Every module gets these -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<release>${java.version}</release>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<argLine>
							--add-opens java.base/java.lang=ALL-UNNAMED
							--add-opens java.base/java.util=ALL-UNNAMED
							--add-opens java.base/java.lang.reflect=ALL-UNNAMED
						</argLine>
					</configuration>
				</plugin>
				<!-- Boot plugin is only bound to an execution in app (the module that produces the
				     runnable jar) — pluginManagement here just pins the version so the module's
				     <build><plugins> reference stays version-less. -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
