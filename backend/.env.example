# Environment variables read by the backend when run outside docker-compose
# (e.g. `SPRING_PROFILES_ACTIVE=prod java -jar admin-api.jar`). The root
# .env.example covers the docker-compose variables instead.
# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/admin_db
SPRING_DATASOURCE_USERNAME=admin_backend
SPRING_DATASOURCE_PASSWORD=changeme

# --- Keycloak (OIDC resource server) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://auth.example.com/realms/fourati-realm
# Only needed when the container reaches Keycloak on a different host than the issuer (see docker-compose.yml)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/fourati-realm/protocol/openid-connect/certs

# --- Prod-only (SecurityConfig refuses to start in prod with a wildcard) ---
APP_CORS_ALLOWED_ORIGINS=https://admin.example.com
# true only behind a proxy that overwrites X-Forwarded-For
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false

# --- Logging / storage ---
LOG_PATH=/var/log/admin-api
# APP_STORAGE_LOCATION=/var/data/uploads
# APP_EXPORT_MAX_ROWS=10000

# --- Rate limiting (requests per minute per user/IP) ---
# FOURATI_COMMON_RATE_LIMIT_RPM=60
