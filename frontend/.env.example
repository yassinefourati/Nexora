# Copy to .env for local development (Vite reads VITE_* at build/dev time).
# The Docker image does NOT use this file; docker-compose passes the same
# values as build args instead.
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_TITLE=Admin Panel
VITE_IDLE_TIMEOUT_MS=900000
VITE_SESSION_WARNING_MS=60000
VITE_OIDC_AUTHORITY=http://localhost:9090/realms/fourati-realm
VITE_OIDC_CLIENT_ID=admin-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_FLAGS={}
