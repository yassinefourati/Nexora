# Copy to .env and adjust as needed. Values below match the seeded dev/demo
# defaults documented in CREDENTIALS.md — safe for local use only, never
# reuse outside a local Docker environment.

# Database
POSTGRES_DB=admin_db
POSTGRES_USER=admin_backend
POSTGRES_PASSWORD=secret

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Requests/minute per client IP for the backend. Production-accurate default
# is 60; raised here for local dev so concurrent dashboard queries on first
# load don't trip 429s.
RATE_LIMIT_RPM=600
